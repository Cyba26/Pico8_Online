<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <!-- WebView principal -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/offlineBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible" />

    <!-- Bouton de mise à jour (en haut à droite) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/updateButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="↓ MàJ"
        android:textSize="12sp"
        android:textColor="@color/textPrimary"
        android:backgroundTint="@color/colorAccent"
        android:visibility="gone"
        android:layout_margin="8dp"
        app:icon="@drawable/ic_update"
        app:iconTint="@color/textPrimary"
        app:iconSize="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentPadding="8dp" />

    <!-- Badge de notification sur le bouton de mise à jour -->
    <FrameLayout
        android:id="@+id/updateBadge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/badge_update"
        android:visibility="gone"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="@+id/updateButton"
        app:layout_constraintEnd_toEndOf="@+id/updateButton"
        app:layout_constraintStart_toStartOf="@+id/updateButton">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="!"
            android:textSize="10sp"
            android:textColor="@color/colorBackground"
            android:gravity="center"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Banner hors ligne -->
    <LinearLayout
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorAccent"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/offlineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_mode"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_in_progress"
            android:textColor="@color/textPrimary"
            android:background="@drawable/button_bg"
            android:padding="8dp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Indicateur de chargement -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
